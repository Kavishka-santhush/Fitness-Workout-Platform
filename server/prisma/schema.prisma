// =====================================================================
// Fitness & Workout Platform — Prisma schema (PostgreSQL)
// Clean architecture: this is the single source of truth for the domain.
// Convention: UUID ids (gen_random_uuid()), camelCase fields, snake_case
// tables via @map, @@index on all high-query fields, JSONB for flexible
// structures (configs, logs, analytics caches).
// Migrations live in prisma/migrations — they are NOT run by the agent.
// =====================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------------------
// ENUMS
// ---------------------------------------------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN
  TRAINER
  NUTRITIONIST
  MEMBER

  @@map("role_enum")
}

enum SubscriptionType {
  FREE
  PREMIUM
  TRAINER_PRO
  NUTRITION_PRO
  ENTERPRISE

  @@map("subscription_type_enum")
}

enum Sex {
  MALE
  FEMALE
  OTHER

  @@map("sex_enum")
}

enum Units {
  METRIC
  IMPERIAL

  @@map("units_enum")
}

enum GoalType {
  WEIGHT_LOSS
  MUSCLE_GAIN
  ENDURANCE
  FLEXIBILITY
  GENERAL_FITNESS
  ATHLETIC_PERFORMANCE
  MAINTENANCE

  @@map("goal_type_enum")
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
  ATHLETE

  @@map("experience_level_enum")
}

enum Difficulty {
  BEGINNER

# Mobile (Expo) environment variables
# All EXPO_PUBLIC_* variables are inlined into the JS bundle at build time.

# Backend REST API base (do NOT include the /api suffix — the client appends it)
EXPO_PUBLIC_API_URL=http://localhost:5000

# Clerk publishable key (browser/front-end key). Auth is handled entirely by Clerk.
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=your_clerk_publishable_key

# Socket.io realtime server (live classes, leaderboards, challenges, notifications)
EXPO_PUBLIC_SOCKET_URL=http://localhost:5000

# Google Maps API key used by react-native-maps for outdoor route tracking
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
